# Standby — local environment template for the supplementary F9T Base Sepolia reproduction.
#
# Copy to .env and fill in locally:   cp .env.example .env
# .env is git-ignored. Never commit it, and never put real values in this file.
#
# Do not add deployed contract addresses here: ./script/testnet/run-base-sepolia.sh deploy generates the
# git-ignored base-sepolia.env manifest itself. See docs/setup.md ("Supplementary Public Testnet (F9T)").

# Base Sepolia RPC endpoint
BASE_RPC_URL=

# Dedicated, funded Base Sepolia deployment/test private key (never a mainnet or personal wallet key)
PRIVATE_KEY=

# Optional: explorer API key, only needed for contract source verification
BASESCAN_API_KEY=
